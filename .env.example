# Copia este archivo a .env y rellena tus datos.
# El .env nunca se sube al repo (está en .gitignore).

# Token del bot, te lo da @BotFather en Telegram
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# A qué chat manda los avisos. Habla con @userinfobot para saber el tuyo
TELEGRAM_CHAT_ID=123456789

# Criptos a vigilar y sus umbrales: id:minimo:maximo, separadas por comas.
# Avisa si baja del minimo o sube del maximo. Deja un lado vacio para ignorarlo.
# Los ids son los de CoinGecko (bitcoin, ethereum, cardano...), no los simbolos.
WATCHLIST=bitcoin:55000:75000,ethereum:2000:4000

# Moneda en la que se consultan los precios
VS_CURRENCY=eur

# Segundos entre consultas cuando corre en bucle (300 = 5 minutos)
CHECK_INTERVAL=300

# Ruta del archivo SQLite con el historico
DATABASE_PATH=data/prices.db
