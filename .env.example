# Copia este archivo a .env y rellena tus datos.
# El .env nunca se sube al repo (está en .gitignore).

# Token del bot, te lo da @BotFather en Telegram
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# A qué chat manda los avisos. Habla con @userinfobot para saber el tuyo
TELEGRAM_CHAT_ID=123456789

# Clave gratuita de CoinGecko (plan Demo). Sin ella, a veces bloquea las
# consultas de precios con un 403. Se saca en coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# Criptos a vigilar. Dos formatos, se pueden mezclar:
#
#   id:paso           -> avisa al cruzar cualquier multiplo de ese paso.
#                        Ej: bitcoin:1000 avisa en 62000, 63000, 64000...
#
#   id:%porcentaje    -> avisa cuando el precio se mueve ese porcentaje.
#                        Ej: bitcoin:%5 avisa a cada subida o bajada del 5%.
#
#   id:minimo:maximo  -> avisa al cruzar esos precios fijos.
#                        Deja un lado vacio para no vigilarlo (ej: ethereum::4000).
#
# Los ids son los de CoinGecko (bitcoin, ethereum, solana...), no los simbolos.
WATCHLIST=bitcoin:%5,ethereum:100,solana:5

# Moneda en la que se consultan los precios (usd, eur, gbp...)
VS_CURRENCY=eur

# Segundos entre consultas cuando corre en bucle. Con 330 (cinco minutos y
# medio) la clave gratuita de CoinGecko da para todo el mes con margen
CHECK_INTERVAL=330

# Ruta del archivo SQLite con el historico
DATABASE_PATH=data/prices.db

# Dias de historico que se guardan. Lo mas viejo se borra solo. 0 = no borrar nada
HISTORY_DAYS=90

# Hora a la que te manda un resumen cada dia. Vacio = sin resumen
RESUMEN_DIARIO=09:00

# Avisa si una cripto sube o baja mucho en poco tiempo, cruce o no sus
# niveles. 8%/1h = un 8% en una hora. Vacio = sin este aviso
MOVIMIENTO_BRUSCO=8%/1h

# Tramo en el que los avisos llegan sin sonar ni vibrar (23-8 = de 11 de la
# noche a 8 de la mañana). No se pierde nada. Vacio = siempre suenan
HORAS_TRANQUILAS=23-8

# Lo que tienes, para ver cuanto vale en el resumen: cripto:cantidad:invertido
# La cantidad es la que te sale en el exchange. Lo invertido es opcional.
# Vacio = sin cartera
PORTFOLIO=bitcoin:0.016:1000,ethereum:0.4:1000
